# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Node / Vite
node_modules/
apps/web/dist/
apps/web/.vite/
apps/web/*.tsbuildinfo
*.log

# Environment & secrets — NEVER commit
.env
.env.local
.env.*.local
secrets/
*.pem
*.key

# State (idempotency artifacts) — generated at runtime.
# Anchor to root (leading slash) so it doesn't shadow src/bot_core/state/,
# which would cause ruff/isort to misclassify bot_core.state imports.
/state/
*.state.json

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Data caches
data/cache/
*.parquet
*.feather

# Backtest output
/backtest/

# Local SQLite DB used as the fallback when POSTGRES_URL is unset
buythedip.db
buythedip.db-journal
