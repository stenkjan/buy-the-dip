# Where the dashboard fetches signals from. Defaults to the static JSON
# published by the scheduled GitHub Action on the `data` branch:
#   https://raw.githubusercontent.com/<owner>/<repo>/data/signals.json
# For local dev against the FastAPI server, set:
#   VITE_SIGNALS_URL=http://localhost:8000/signals
# VITE_SIGNALS_URL=

# Static data overrides (all default to the `data` branch via raw.githubusercontent):
# VITE_HISTORY_URL=
# VITE_DCA_BASE_URL=
# VITE_TIMELINE_BASE_URL=

# Base URL of the FastAPI server for the "Bots" control-plane tab.
# Defaults to http://localhost:8000. The Bots tab also needs the admin
# API key (entered in the UI, matching the server's API_KEY env).
# VITE_API_BASE_URL=http://localhost:8000
