# Copy to .env and fill in. NEVER commit .env.
# All secrets must come from environment / GitHub Secrets, never from code.

# --- Notifications (optional, Phase 1) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Market data provider (Phase 2 production source) ---
# yfinance needs no key. Polygon / Tiingo do.
DATA_PROVIDER=yfinance
DATA_API_KEY=

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173

# --- Web (Vite) ---
# Place in apps/web/.env.local — must be prefixed VITE_ to be exposed.
# VITE_API_BASE_URL=http://localhost:8000
