# Copy to .env and fill in. NEVER commit .env.
# All secrets must come from environment / GitHub Secrets, never from code.

# --- Notifications (optional, Phase 1) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Market data provider (Phase 2 production source) ---
# yfinance needs no key. Polygon / Tiingo do.
DATA_PROVIDER=yfinance
DATA_API_KEY=

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173
# Admin key for the bot control plane (Phase 6). When unset, the /bots
# endpoints return 503 (disabled) so the public deploy stays read-only.
# When set, mutating calls require an X-API-Key header matching this value.
API_KEY=

# --- Web (Vite) ---
# Place in apps/web/.env.local — must be prefixed VITE_ to be exposed.
# VITE_API_BASE_URL=http://localhost:8000

# --- DB (Phase 4, optional — falls back to local SQLite if unset) ---
# Pooled URL used by the app, non-pooling URL used by Alembic migrations.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Broker (Phase 4 scaffold, no live wiring yet) ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
